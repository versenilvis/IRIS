#!/usr/bin/env bash
set -e
ASDF_VERSION=$1
ASDF_DOWNLOAD_PATH=$2

OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

if [ "$ARCH" = "x86_64" ]; then
  ARCH="amd64"
elif [ "$ARCH" = "aarch64" ]; then
  ARCH="arm64"
fi

URL="https://github.com/versenilvis/iris/releases/download/v${ASDF_VERSION}/iris_${OS}_${ARCH}.tar.gz"

echo "Downloading Iris from $URL"
curl -sSL "$URL" -o "$ASDF_DOWNLOAD_PATH/iris.tar.gz"
tar -xzf "$ASDF_DOWNLOAD_PATH/iris.tar.gz" -C "$ASDF_DOWNLOAD_PATH"
rm "$ASDF_DOWNLOAD_PATH/iris.tar.gz"
